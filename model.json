{
  "config": [
    {
      "default_expr": "patch",
      "name": "dependent_bump_level",
      "type_expr": "BumpLevel"
    },
    {
      "default_expr": "\"internal\"",
      "name": "exempt_label",
      "type_expr": "String"
    },
    {
      "default_expr": "\"release/\"",
      "name": "release_branch_prefix",
      "type_expr": "String"
    },
    {
      "default_expr": "\"release\"",
      "name": "release_label",
      "type_expr": "String"
    }
  ],
  "entities": [
    {
      "fields": [
        {
          "name": "base_branch",
          "type_expr": "String"
        }
      ],
      "kind": "external",
      "name": "Repository"
    },
    {
      "fields": [
        {
          "name": "repository",
          "type_expr": "Repository"
        },
        {
          "name": "head_branch",
          "type_expr": "String"
        },
        {
          "name": "base_branch",
          "type_expr": "String"
        },
        {
          "name": "labels",
          "type_expr": "Set<String>"
        },
        {
          "name": "changed_files",
          "type_expr": "Set<String>"
        }
      ],
      "kind": "external",
      "name": "PullRequest"
    },
    {
      "fields": [
        {
          "name": "name",
          "type_expr": "String"
        }
      ],
      "kind": "external",
      "name": "GitTag"
    },
    {
      "fields": [
        {
          "name": "tag",
          "type_expr": "GitTag"
        },
        {
          "name": "draft",
          "type_expr": "Boolean"
        }
      ],
      "kind": "external",
      "name": "GitHubRelease"
    },
    {
      "fields": [
        {
          "name": "repository",
          "type_expr": "Repository"
        },
        {
          "name": "name",
          "type_expr": "String"
        },
        {
          "name": "versioned_files",
          "type_expr": "Set<String>"
        },
        {
          "name": "changelog_file",
          "type_expr": "String"
        },
        {
          "name": "version",
          "type_expr": "Version"
        },
        {
          "name": "dependencies",
          "type_expr": "Set<Package>"
        },
        {
          "name": "tag_template",
          "type_expr": "String"
        },
        {
          "enum_values": [
            "none",
            "tag",
            "tag_and_release"
          ],
          "name": "release_mode",
          "type_expr": "none | tag | tag_and_release"
        },
        {
          "name": "release_as_draft",
          "type_expr": "Boolean"
        },
        {
          "name": "has_pending_bump",
          "type_expr": "pending_changesets.any(c => c.unreleased_for(this.name))"
        }
      ],
      "kind": "internal",
      "name": "Package",
      "projections": [
        {
          "name": "pending_changesets",
          "source": "changesets"
        },
        {
          "name": "open_release_pull_request",
          "source": "release_pull_requests"
        }
      ],
      "relationships": [
        {
          "name": "changesets",
          "target": "Changeset"
        },
        {
          "name": "release_pull_requests",
          "target": "ReleasePullRequest"
        },
        {
          "name": "dependents",
          "target": "Package"
        }
      ]
    },
    {
      "fields": [
        {
          "name": "repository",
          "type_expr": "Repository"
        },
        {
          "name": "file",
          "type_expr": "String"
        },
        {
          "name": "bumps",
          "type_expr": "Set<Bump>"
        },
        {
          "name": "summary",
          "type_expr": "String"
        },
        {
          "name": "released_packages",
          "type_expr": "Set<String>"
        },
        {
          "enum_values": [
            "pending",
            "consumed"
          ],
          "name": "status",
          "type_expr": "pending | consumed"
        },
        {
          "name": "fully_released",
          "type_expr": "bumps.all(b => b.package_name in released_packages)"
        }
      ],
      "kind": "internal",
      "name": "Changeset",
      "transition_graphs": [
        {
          "edges": [
            {
              "from": "pending",
              "to": "consumed"
            }
          ],
          "field": "status",
          "states": [
            "consumed",
            "pending"
          ],
          "terminal": [
            "consumed"
          ]
        }
      ]
    },
    {
      "fields": [
        {
          "name": "pull_request",
          "type_expr": "PullRequest"
        },
        {
          "name": "affected_packages",
          "type_expr": "Set<Package>"
        },
        {
          "name": "covered_packages",
          "type_expr": "Set<Package>"
        },
        {
          "enum_values": [
            "passed",
            "failed",
            "exempt"
          ],
          "name": "status",
          "type_expr": "passed | failed | exempt"
        }
      ],
      "kind": "internal",
      "name": "ChangesetCheck",
      "projections": [
        {
          "name": "missing_packages",
          "source": "affected_packages"
        }
      ]
    },
    {
      "fields": [
        {
          "name": "package",
          "type_expr": "Package"
        },
        {
          "name": "pull_request",
          "type_expr": "PullRequest"
        },
        {
          "enum_values": [
            "release",
            "pre_release"
          ],
          "name": "kind",
          "type_expr": "release | pre_release"
        },
        {
          "name": "from_version",
          "type_expr": "Version"
        },
        {
          "name": "to_version",
          "type_expr": "Version"
        },
        {
          "name": "stacked_on",
          "optional": true,
          "type_expr": "ReleasePullRequest?"
        },
        {
          "enum_values": [
            "open",
            "merged",
            "absorbed",
            "closed"
          ],
          "name": "status",
          "type_expr": "open | merged | absorbed | closed"
        },
        {
          "name": "absorbed_into",
          "type_expr": "ReleasePullRequest",
          "when_set": {
            "qualifying_states": [
              "absorbed"
            ],
            "status_field": "status"
          }
        }
      ],
      "kind": "internal",
      "name": "ReleasePullRequest",
      "relationships": [
        {
          "name": "absorbed",
          "target": "ReleasePullRequest"
        }
      ],
      "transition_graphs": [
        {
          "edges": [
            {
              "from": "open",
              "to": "merged"
            },
            {
              "from": "open",
              "to": "absorbed"
            },
            {
              "from": "open",
              "to": "closed"
            }
          ],
          "field": "status",
          "states": [
            "absorbed",
            "closed",
            "merged",
            "open"
          ],
          "terminal": [
            "merged",
            "absorbed",
            "closed"
          ]
        }
      ]
    },
    {
      "fields": [
        {
          "name": "package",
          "type_expr": "Package"
        },
        {
          "name": "previous_version",
          "type_expr": "Version"
        },
        {
          "name": "version",
          "type_expr": "Version"
        },
        {
          "enum_values": [
            "committed",
            "tagged",
            "drafted",
            "published"
          ],
          "name": "status",
          "type_expr": "committed | tagged | drafted | published"
        },
        {
          "name": "tag",
          "type_expr": "GitTag",
          "when_set": {
            "qualifying_states": [
              "tagged",
              "drafted",
              "published"
            ],
            "status_field": "status"
          }
        },
        {
          "name": "github_release",
          "type_expr": "GitHubRelease",
          "when_set": {
            "qualifying_states": [
              "drafted",
              "published"
            ],
            "status_field": "status"
          }
        }
      ],
      "kind": "internal",
      "name": "Release",
      "transition_graphs": [
        {
          "edges": [
            {
              "from": "committed",
              "to": "tagged"
            },
            {
              "from": "tagged",
              "to": "drafted"
            },
            {
              "from": "tagged",
              "to": "published"
            },
            {
              "from": "drafted",
              "to": "published"
            }
          ],
          "field": "status",
          "states": [
            "committed",
            "drafted",
            "published",
            "tagged"
          ],
          "terminal": [
            "published"
          ]
        }
      ]
    },
    {
      "fields": [
        {
          "name": "login",
          "type_expr": "String"
        },
        {
          "name": "is_maintainer",
          "type_expr": "Boolean"
        }
      ],
      "kind": "external",
      "name": "GitHubUser"
    },
    {
      "fields": [
        {
          "name": "repository",
          "type_expr": "Repository"
        }
      ],
      "kind": "external",
      "name": "ReleaseWorkflow"
    }
  ],
  "enums": [
    {
      "name": "BumpLevel",
      "values": [
        "major",
        "minor",
        "patch"
      ]
    }
  ],
  "value_types": [
    {
      "fields": [
        {
          "name": "major",
          "type_expr": "Integer"
        },
        {
          "name": "minor",
          "type_expr": "Integer"
        },
        {
          "name": "patch",
          "type_expr": "Integer"
        },
        {
          "name": "prerelease",
          "optional": true,
          "type_expr": "String?"
        }
      ],
      "name": "Version"
    },
    {
      "fields": [
        {
          "name": "package_name",
          "type_expr": "String"
        },
        {
          "name": "level",
          "type_expr": "BumpLevel"
        }
      ],
      "name": "Bump"
    }
  ],
  "version": 3
}
