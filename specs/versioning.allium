-- allium: 3
-- versioning.allium

-- Scope: A versioning tool shared across LiveKit SDK repositories,
--   for single packages and monorepos.
-- Includes: Changeset files, changeset checks on contributor PRs,
--   version bumping, dependent propagation, one release PR,
--   changelogs, git tags, GitHub releases (published or draft).
-- Excludes:
--   - Publishing to registries (npm, crates.io, PyPI): the repo workflow does this
--   - Building release assets: the repo workflow does this, then attaches them
--   - Conventional commit parsing
-- Dependencies: Pull requests, tags and releases live in GitHub (external).
-- Language support: each versioned file is handled by a plugin that fulfils
--   the VersionedFileHandler contract. The tool itself knows no language.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity Repository {
    base_branch: String
}

external entity PullRequest {
    repository: Repository
    head_branch: String
    base_branch: String
    labels: Set<String>
    changed_files: Set<String>
}

-- A tag belongs to a package when its name matches the package's
-- tag_template; the version is the one the name carries.
external entity GitTag {
    name: String
    package: Package?
    version: Version?
}

external entity GitHubRelease {
    tag: GitTag
    draft: Boolean
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value Version {
    major: Integer
    minor: Integer
    patch: Integer
    -- e.g. "rc.1"; absent for a final release
    prerelease: String?

    is_prerelease: prerelease != null
}

-- A file without a known format (gradle.properties, a .podspec, a version
-- constant in source) names a regex whose `version` group holds the version.
-- Only that group is rewritten. Such a file carries no dependency pins.
value VersionedFile {
    path: String
    regex: String?
}

value Bump {
    package_name: String
    level: BumpLevel
}


------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- Implemented once per file format (package.json, Cargo.toml, pyproject.toml, ...).
contract VersionedFileHandler {
    read_version: (file: String) -> Version
    write_version: (file: String, version: Version) -> String
    internal_dependencies: (file: String) -> Set<String>
    -- A bump of package X must also update the pin on X in files of its
    -- dependents (rust-sdks lists root Cargo.toml and Cargo.lock per crate).
    write_dependency_version: (file: String, dependency: String, version: Version) -> String

    @invariant Roundtrip
        -- read_version(write_version(file, v)) = v for every supported file.

    @invariant MinimalEdit
        -- write_version changes only the version fields; formatting and
        -- unrelated content of the file are preserved.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum BumpLevel { major | minor | patch }

-- custom: exists_url with {name} and {version}, answering 200 or 404.
enum Registry { none | crates | npm | pypi | pubdev | custom }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Package {
    repository: Repository
    name: String
    -- May mix formats (livekit-ffi lists Cargo.toml and package.json files).
    -- Each file goes to the VersionedFileHandler for its format. Lock files
    -- (Cargo.lock, uv.lock) are versioned files too, edited directly by a
    -- handler; the tool never runs a package manager. The first file is
    -- the version; files that disagree are a warning (VersionedFilesAgree).
    versioned_files: Set<VersionedFile>
    changelog_file: String
    version: Version
    dependencies: Set<Package>
    -- Template for the tag name. Default: "v{version}" in a single-package
    -- repo, "{package}-v{version}" in a monorepo.
    tag_template: String
    release_mode: none | tag | tag_and_release
    -- When true the GitHub release stays a draft until the repo workflow
    -- has attached its assets and publishes it.
    release_as_draft: Boolean
    -- Where the package is published: crates | npm | pypi | pubdev |
    -- custom (an exists_url with {name} and {version}) | none. Defaults
    -- to config.publish.registry. The tool only asks whether a version is
    -- there; publishing is the command below. The answer is 200, 404, or
    -- an error: a registry outage never reads as "not there yet".
    registry: Registry = config.publish.registry
    exists_url: String? = config.publish.exists_url
    -- null when registry = none.
    on_registry(v): registry_has_version(registry, exists_url, name, v)
    -- The shell command that publishes this package, run in its path:
    -- the package's own, else config.publish.publish when the package is
    -- on the default registry, else the built-in command for its
    -- registry (cargo publish, npm publish, twine upload, dart pub
    -- publish), else none and `publish` refuses to start.
    publish_command: String?
    -- True when config.publish.workspace is set and the package has no
    -- publish command of its own and no registry other than the default:
    -- the workspace command publishes it, and publish_command is unused.
    in_workspace_publish: Boolean
    -- The shell command that checks the public API of this package on a
    -- contributor PR: the package's own, else config.check.api, else
    -- none and the check only asks for a changeset. It runs in the
    -- package's path with the claimed level and the baseline tag, and
    -- prints the lowest change kind it can prove the diff needs (major,
    -- minor or patch), or nothing when it cannot tell.
    api_command: String?

    changesets: Changeset with repository = this.repository
    pending_changesets: changesets where status = pending
    release_pull_requests: ReleasePullRequest with releases.any(r => r.package = this)
    open_release_pull_request: release_pull_requests where status = open and kind = release
    dependents: Package with dependencies.any(d => d = this)

    -- A package left at a pre-release has its promotion pending, with or
    -- without changesets: an rc is never the last word.
    has_pending_bump: pending_changesets.any(c => c.unreleased_for(this.name)) or version.is_prerelease
    -- Nothing published yet: a registry with trusted publishing needs the
    -- first upload done by hand, so the release PR and the handoff say so.
    -- A registry with a package-level lookup answers; without one (none,
    -- custom) no tag of another version means a first release.
    first_release:
        if registry in {none, custom}: not GitTags.any(t => t.package = this and t.version != version)
        else: not registry_has_any_version(registry, name)
}

-- Exactly the changesets file format: `.changeset/<name>.md`, YAML front
-- matter with one `package: level` line per bump (package names quoted or
-- unquoted, level major | minor | patch), markdown body as the summary.
entity Changeset {
    repository: Repository
    file: String
    bumps: Set<Bump>
    summary: String
    -- The release PR carries every package a pending changeset names, so
    -- the merge consumes every file whole. Nothing is derived from tags: a
    -- repo that adopts the tool with tags behind its versions, or a package
    -- with release_mode none, works the same.
    status: pending | consumed

    unreleased_for(name): bumps.any(b => b.package_name = name)

    transitions status {
        pending -> consumed
        terminal: consumed
    }
}

-- The result of checking one contributor PR for changeset coverage.
-- The contributor sees one PR comment, updated in place: the bumps the
-- PR claims, the missing packages, a link that opens a prefilled
-- changeset file on the PR branch, and the exemption label hint. The
-- comment is removed when the PR is exempt or claims no bump and passes.
entity ChangesetCheck {
    pull_request: PullRequest
    affected_packages: Set<Package>
    covered_packages: Set<Package>
    -- Covered packages whose changeset level is below what the API
    -- check proved, or whose check did not run.
    api_findings: Set<ApiFinding>
    -- What the PR's changesets claim, one per package at the highest
    -- level. The comment lists them on a passing PR too, so the reviewer
    -- sees the release the merge will cause.
    bumps: Set<Bump>
    -- Packages the plan over the PR's changesets alone includes without
    -- a changeset of their own: dependents and fixed-group members. The
    -- comment names them with the reason, without a level or a version,
    -- because both can change before the merge.
    also_released: Set<Package>
    -- release_pull_request: the head branch carries the release prefix.
    -- A release PR consumes changesets rather than adding one.
    status: passed | failed | exempt | release_pull_request

    missing_packages: affected_packages where not (this in covered_packages)
}

-- A tool answers with a kind of change, a changeset names the digit that
-- moves. The digit a kind moves depends on the version: major is the
-- first non-zero digit, so a breaking change on 0.x needs minor and on
-- 0.0.x patch. required_level(version, kind) is that translation.
value ApiFinding {
    package: Package
    claimed_level: BumpLevel
    -- none when the command failed or printed something unreadable
    required_level: BumpLevel?
    output: String
}

-- One package's part of a release PR.
value PlannedRelease {
    package: Package
    from_version: Version
    to_version: Version
}

-- One release PR per repository carries every package with a pending bump,
-- dependents included, so one merge releases them together and no pin
-- ever points at an unreleased version. Branch: <prefix><base branch>.
entity ReleasePullRequest {
    repository: Repository
    pull_request: PullRequest
    -- release: opened by the tool from pending changesets.
    -- pre_release: opened on demand by a maintainer for one package from
    -- the current state; the version carries a prerelease suffix
    -- (e.g. 1.6.0-rc.1).
    kind: release | pre_release
    releases: Set<PlannedRelease>
    status: open | merged | closed

    transitions status {
        open -> merged
        open -> closed
        terminal: merged, closed
    }
}

entity Release {
    package: Package
    previous_version: Version
    version: Version
    status: committed | tagged | drafted | published
    tag: GitTag when status = tagged | drafted | published
    github_release: GitHubRelease when status = drafted | published

    -- The release PR always writes one. A version with none was edited
    -- by hand, not released by a release PR.
    has_changelog_entry: changelog_has_entry(package.changelog_file, version)

    transitions status {
        committed -> tagged
        tagged -> drafted
        tagged -> published
        drafted -> published
        terminal: published
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Bump level the tool applies itself to a package whose internal
    -- dependency was bumped. A changeset never has to name dependents;
    -- the changeset check only looks at packages whose own files changed.
    dependent_bump_level: BumpLevel = patch
    -- Label of on-demand pre-releases: 1.6.0-rc.1. Spelling per file format
    -- is the handler's job (PEP 440 in pyproject.toml: 1.6.0rc1).
    prerelease_label: String = "rc"
    -- PRs carrying this label need no changeset.
    exempt_label: String = "internal"
    -- Defaults for `verwalter publish`: how many independent packages run
    -- at once, the registry and the command every package takes unless
    -- it sets its own.
    -- `workspace` is one command, run once from the root, for every
    -- package on the default registry without a `publish` of its own:
    -- the ecosystem's recursive publish. Order and skipping are its job;
    -- the tool checks the registry before (all there: skip) and after
    -- (per member: there or failed), and blocks dependents of a member
    -- that is not there.
    publish: { jobs: Integer = 4, registry: Registry = none, exists_url: String?, publish: String?, workspace: String? }
    -- Default api_command for `verwalter check`, overridden per package.
    check: { api: String? }
    -- Files outside any package that pin every package's version: a
    -- workspace Cargo.toml, Cargo.lock, package-lock.json. Every release,
    -- pre-releases included, updates its own entry in each of them, so
    -- the workspace still resolves.
    pin_files: Set<String> = {}
    -- Workspace members the consistency check skips, by name or path; a
    -- trailing `*` matches a prefix (`examples/*`).
    ignore: Set<String> = {}
    -- Groups of packages that always release at one shared version: the
    -- highest version in the group, bumped by the highest level any
    -- member needs. A member with no changeset of its own comes along.
    -- A pre-release of a member takes the whole group. Members whose
    -- committed versions differ are warned about until a release aligns
    -- them. A package is in at most one group.
    fixed: Set<Set<Package>> = {}
    -- Release PRs are recognisable by branch prefix and label so that repo
    -- workflows can gate them (approvals, registry checks). Gating itself
    -- is a workflow concern, not the tool's.
    release_branch_prefix: String = "release/"
    release_label: String = "release"
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Workspace consistency: every publishable package the workspace
-- manifests declare must be a configured Package or ignored, and a
-- configured Package must exist. A private package may be configured: it
-- is versioned and released on GitHub, just not published to a registry.
-- The check fails on a mismatch, every other command warns, so a new
-- package cannot escape versioning. is_configured(m): a configured
-- Package has the member's name, compared normalised (PEP 503:
-- `play_py_ext` is `play-py-ext`). ignored(m) matches config.ignore
-- against the name or the path.
rule WorkspaceConsistencyCheck {
    when: ContributorPullRequestUpdated(pr)
    let members = workspace_members(pr.repository)
    requires: members.all(m => m.private or is_configured(m) or ignored(m, config.ignore))
    requires: filter(Packages, p => p.repository = pr.repository).all(p => package_present(p))
    ensures: WorkspaceConsistent(repository: pr.repository)
}

-- Changeset check on contributor PRs

-- ContributorWritesChangeset: the local counterpart. The packages the
-- branch changes against the base, minus those a pending changeset
-- covers, get one file with the given level and the last commit subject.
-- Named packages replace the detection.
-- A changeset in the PR that the tool cannot read, or that names a
-- package not in the config, is the check's own finding: the comment
-- carries the error, and the check fails.
rule ChangesetCheckOnContributorPullRequest {
    when: ContributorPullRequestUpdated(pr)
    let affected = affected_packages(pr.changed_files)
    let covered = covered_packages(pr.changed_files)
    ensures:
        if starts_with(pr.head_branch, config.release_branch_prefix):
            ChangesetCheck.created(pull_request: pr, affected_packages: affected, covered_packages: covered, status: release_pull_request)
        else:
            if config.exempt_label in pr.labels:
                ChangesetCheck.created(pull_request: pr, affected_packages: affected, covered_packages: covered, status: exempt)
            else:
                if affected.all(p => p in covered):
                    ChangesetCheck.created(pull_request: pr, affected_packages: affected, covered_packages: covered, status: passed)
                else:
                    ChangesetCheck.created(pull_request: pr, affected_packages: affected, covered_packages: covered, status: failed)
}

-- The changeset level is the contributor's claim. For every affected
-- package that a changeset covers and that has an api_command, the
-- command is the oracle: its answer, translated to a digit for the
-- package's version, must not exceed the claimed level. A finding fails
-- the check, and the comment names the level to use. An exempt PR or a
-- release PR runs no command. The command runs in the package's path
-- with the claimed level and the baseline tag (the tag of the current
-- version) in its environment. run_api_command returns the outcome,
-- the kind of change when answered, and the output. The outcome is
-- failed (non-zero exit), unreadable (it printed something other than
-- major, minor or patch), silent (it printed nothing: it cannot tell)
-- or answered.
rule ApiCheckOnCoveredPackages {
    when: check: ChangesetCheck.created
    requires: check.status in {passed, failed}
    let checked = check.affected_packages where this in check.covered_packages and this.api_command != null
    ensures:
        for p in checked:
            let claimed = max(check.pull_request.changesets.bumps where package = p -> level)
            let answer = run_api_command(p.api_command, claimed, tag_for(p.tag_template, p.name, p.version))
            if answer.outcome in {failed, unreadable}:
                check.api_findings.add(ApiFinding(package: p, claimed_level: claimed, required_level: null, output: answer.output))
            else:
                if answer.outcome = answered and claimed < required_level(p.version, answer.kind):
                    check.api_findings.add(ApiFinding(package: p, claimed_level: claimed, required_level: required_level(p.version, answer.kind), output: answer.output))
        if check.api_findings != {}:
            check.status = failed
}

-- Release PR lifecycle

-- A bump line must name a configured package; a typo is refused by every
-- command, the changeset check included, rather than left in place.
rule ContributorAddsChangeset {
    when: ContributorAddsChangeset(contributor, repository, file, bumps, summary)
    requires: bumps.all(b => Packages.any(p => p.repository = repository and p.name = b.package_name))
    ensures: Changeset.created(repository: repository, file: file, bumps: bumps, summary: summary, status: pending)
}

rule ChangesetLandsOnBaseBranch {
    when: changeset: Changeset.created
    ensures: ReleasePlanRecomputed(repository: changeset.repository)
}

-- Every recompute regenerates the release branch from the current base
-- branch and force-pushes it; the PR is updated in place. The branch
-- applies every planned release, dependencies first, and consumes the
-- changesets.
rule OpenOrUpdateReleasePullRequest {
    when: ReleasePlanRecomputed(repository)
    let pending = filter(Packages, p => p.repository = repository and p.has_pending_bump)
    -- next_version of a pre-release is its final version (the promote
    -- step) when that version covers the pending level, else that version
    -- bumped by the level: 1.6.0-rc.2 with a major pending gives 2.0.0.
    -- A release is never lower than the rc before it.
    -- 0.x follows the changesets rules: major gives 1.0.0, minor bumps
    -- the minor component. (knope and rust-sdks today bump one level
    -- lower on 0.x; this is a deliberate change.) A fixed group moves
    -- whole, from its highest version.
    let planned = pending.map(p => PlannedRelease(package: p, from_version: p.version, to_version: next_version(p.version, p.pending_changesets, config.dependent_bump_level, config.fixed)))
    let open = filter(ReleasePullRequests, r => r.repository = repository and r.status = open and r.kind = release)
    requires: not pending.empty
    ensures:
        if open.count = 0:
            ReleasePullRequest.created(
                repository: repository,
                pull_request: release_branch_pull_request(repository),
                kind: release,
                releases: planned,
                status: open
            )
        else:
            open.first.releases = planned
        -- Changelog entry for each new version: sections per bump level,
        -- one line per changeset with summary, PR link and author, plus
        -- an "updated dependencies" line for bumps the tool added itself.
        for p in pending:
            ChangelogUpdated(package: p, changesets: p.pending_changesets)
}

-- With nothing pending there is no release PR.
rule CloseReleasePullRequestWithNothingPending {
    when: ReleasePlanRecomputed(repository)
    for rpr in ReleasePullRequests where repository = repository and status = open and kind = release:
        requires: filter(Packages, p => p.repository = repository and p.has_pending_bump).empty
        ensures: rpr.status = closed
}

-- One rc PR, apart from the release PR, on one branch named after the
-- requested package's fixed group: <prefix><first member>-rc. The rc
-- carries the requested package, its fixed group, and every in-repo
-- dependency with a pending changeset, transitively, with its own group:
-- an rc of a dependent must not ship against a dependency whose change
-- is only on the base branch. Each group has one rc version, and the
-- pins between the carried packages move to the rc versions.
-- Dependents outside the rc are not pre-released and not pinned to it.
-- The rc branch bumps the carried packages' own files, their entries
-- in config.pin_files, the pins among them and their changelogs.
-- The level of the requested group is the maintainer's when given, else
-- the highest its pending changesets name, else patch; a pulled-in
-- group takes the level its own changesets name.
rule MaintainerRequestsPreRelease {
    when: MaintainerRequestsPreRelease(maintainer, package, target_branch, level?)
    let group = fixed_group_of(package, config.fixed)
    let pulled = closure(group, g => g.dependencies where this.has_pending_bump, d => fixed_group_of(d, config.fixed))
    let next = next_prerelease_version(group, level, config.prerelease_label)
    ensures:
        ReleasePullRequest.created(
            repository: package.repository,
            pull_request: release_branch_pull_request(package, target_branch),
            kind: pre_release,
            releases: group.map(m => PlannedRelease(package: m, from_version: m.version, to_version: next)) + pulled.map(p => PlannedRelease(package: p, from_version: p.version, to_version: next_prerelease_version(fixed_group_of(p, config.fixed), none, config.prerelease_label))),
            status: open
        )
}

-- Merging the PR releases every package it carries.
rule MaintainerMergesReleasePullRequest {
    when: MaintainerMergesReleasePullRequest(maintainer, rpr)
    requires: rpr.status = open
    ensures:
        rpr.status = merged
        for r in rpr.releases:
            PackageReleased(rpr: rpr, release: r)
        ReleasePlanRecomputed(repository: rpr.repository)
}

rule ApplyRelease {
    when: PackageReleased(rpr, release)
    ensures:
        release.package.version = release.to_version
        Release.created(package: release.package, previous_version: release.from_version, version: release.to_version, status: committed)
}

-- A pre-release keeps the changesets pending so the final release still
-- lists them. A release deletes every changeset that names its package;
-- the PR carries every named package, so no line is left behind. A
-- changeset with no bump lines names nothing and goes with any release.
-- Note: allium 3.2.4 does not witness bulk updates in a `for` clause, so
-- `check` reports Changeset.consumed as unreachable. This is the intended path.
rule ConsumeChangesets {
    when: PackageReleased(rpr, release)
    requires: rpr.kind = release
    for c in Changesets where status = pending and repository = rpr.repository:
        requires: c.unreleased_for(release.package.name) or c.bumps = {}
        ensures: c.status = consumed
}

-- Closing has no lasting effect: the changesets stay pending, so the next
-- recompute opens a fresh PR.
rule MaintainerClosesReleasePullRequest {
    when: MaintainerClosesReleasePullRequest(maintainer, rpr)
    requires: rpr.status = open
    ensures:
        rpr.status = closed
        ReleasePlanRecomputed(repository: rpr.repository)
}

-- Tag and GitHub release

-- Tagging and release creation are resumable. If either fails, the run
-- fails and the Release stays where it is; every later run retries every
-- Release that is not complete. A tag that already exists, local or on the
-- remote, counts as done wherever it points: the tool cannot tell a release
-- made long ago from a bump that skipped tagging.
-- ReleaseNeedsChangelogEntry: a version with no tag and no changelog entry
-- for it was edited by hand, not released by a release PR. It is left
-- alone with a warning, unless the maintainer names the package.
rule TagRelease {
    when: release: Release.created
    requires: release.status = committed
    requires: release.package.release_mode != none
    requires: release.has_changelog_entry
    ensures:
        release.status = tagged
        release.tag = tag_for(release.package.tag_template, release.package.name, release.version)
}

-- Releases are tagged and created in dependency order, and a run stops
-- at the first failure: a dependent is never released before its
-- dependency. A run that names a package handles that package only and
-- reports it even when nothing was left to do, so a manual run can hand
-- one release to the publish step again.
rule ResumeUntaggedReleases {
    when: ToolRunStarted(repository, named?, publish_drafts)
    for release in Releases where package.repository = repository and status = committed:
        requires: named = null or release.package = named
        requires: release.package.release_mode != none
        requires: release.has_changelog_entry or release.package = named
        ensures:
            release.status = tagged
            release.tag = tag_for(release.package.tag_template, release.package.name, release.version)
}

-- A run asked to publish creates the release published, draft or not.
rule ResumeTaggedReleasesWithoutGitHubRelease {
    when: ToolRunStarted(repository, named?, publish_drafts)
    for release in Releases where package.repository = repository and status = tagged:
        requires: named = null or release.package = named
        requires: release.package.release_mode = tag_and_release
        ensures:
            if release.package.release_as_draft and not publish_drafts:
                release.status = drafted
                release.github_release = github_release_for(release.tag, true)
            else:
                release.status = published
                release.github_release = github_release_for(release.tag, false)
}

-- A run asked to publish flips every draft it handles once the assets
-- are there: the WorkflowPublishesRelease step, from the command line.
rule PublishDraftsOnToolRun {
    when: ToolRunStarted(repository, named?, publish_drafts)
    for release in Releases where package.repository = repository and status = drafted:
        requires: publish_drafts
        requires: named = null or release.package = named
        ensures: release.status = published
}

-- The run's assets are attached when the release is created.
rule CreateGitHubRelease {
    when: release: Release.status transitions_to tagged
    requires: release.status = tagged
    requires: release.package.release_mode = tag_and_release
    ensures:
        if release.package.release_as_draft:
            release.status = drafted
            release.github_release = github_release_for(release.tag, true)
        else:
            release.status = published
            release.github_release = github_release_for(release.tag, false)
}

-- A draft the workflow never publishes is the workflow's to finish or
-- delete. The tool neither waits for it nor blocks later releases of the
-- package; each release gets its own tag and draft.
-- A release whose commit turned out broken is abandoned: the GitHub
-- release and the tag go away, the version in the files stays. The next
-- changeset produces a new version; the registry is never touched.
rule MaintainerAbandonsRelease {
    when: MaintainerAbandonsRelease(maintainer, release)
    requires: release.status != committed
    ensures: not exists release
}

-- Assets can be attached to an existing GitHub release, for example after
-- a failed upload; attaching is idempotent. A draft takes them, a
-- published release only when the workflow names its package: in a
-- monorepo an asset must not land on every complete release. A tag-only
-- release has no GitHub release to attach to.
rule WorkflowAttachesAssets {
    when: WorkflowAttachesAssets(workflow, release, assets, package_named)
    requires: release.status = drafted or (release.status = published and package_named)
    ensures: ReleaseAssetsAttached(release: release, assets: assets)
}

rule WorkflowPublishesDraftRelease {
    when: WorkflowPublishesRelease(workflow, release)
    requires: release.status = drafted
    ensures: release.status = published
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- At most one open release PR per repository and one open pre-release PR
-- per package. The two can be open at the same time; the pre-release one
-- is short-lived.
invariant OneOpenReleasePullRequestPerRepository {
    Repositories.all(repo =>
        filter(ReleasePullRequests, r => r.repository = repo and r.status = open and r.kind = release).count <= 1)
}

invariant OneOpenPreReleasePullRequestPerPackage {
    Packages.all(p =>
        filter(ReleasePullRequests, r => r.status = open and r.kind = pre_release and r.releases.any(x => x.package = p)).count <= 1)
}

invariant ReleasePullRequestsAreRecognisable {
    ReleasePullRequests.all(r =>
        starts_with(r.pull_request.head_branch, config.release_branch_prefix)
        and config.release_label in r.pull_request.labels)
}

-- A final release only ever targets the repository base branch. An rc PR
-- may target any branch, for example a maintenance branch.
invariant FinalReleasesTargetBaseBranch {
    ReleasePullRequests.all(r =>
        r.kind = pre_release or r.pull_request.base_branch = r.repository.base_branch)
}

-- A release PR carries every dependent of every package it releases, so
-- a merge never leaves a dependent pinned to an unreleased version.
invariant ReleasePullRequestCoversDependents {
    filter(ReleasePullRequests, r => r.status = open and r.kind = release).all(rpr =>
        rpr.releases.all(r => r.package.dependents.all(d => rpr.releases.any(x => x.package = d))))
}

-- A fixed group is in a PR whole, at one version.
invariant FixedGroupReleasesTogether {
    filter(ReleasePullRequests, r => r.status = open).all(rpr =>
        config.fixed.all(g =>
            g.all(p => rpr.releases.any(x => x.package = p)) or g.all(p => not rpr.releases.any(x => x.package = p)))
        and config.fixed.all(g =>
            rpr.releases.all(a => rpr.releases.all(b => not (a.package in g and b.package in g) or a.to_version = b.to_version))))
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

external entity GitHubUser {
    login: String
    is_maintainer: Boolean
}

external entity ReleaseWorkflow {
    repository: Repository
}

actor Contributor {
    identified_by: GitHubUser where is_maintainer = false
}

actor Maintainer {
    identified_by: GitHubUser where is_maintainer = true
}

actor Workflow {
    identified_by: ReleaseWorkflow where repository != null
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface ContributorPullRequest {
    facing contributor: Contributor
    context pr: PullRequest

    exposes:
        pr.changed_files
        pr.labels

    provides:
        ContributorPullRequestUpdated(pr)
        ContributorAddsChangeset(contributor, pr.repository, file, bumps, summary)
}

surface ContributorPullRequestCheck {
    facing contributor: Contributor
    context check: ChangesetCheck

    exposes:
        check.status
        check.affected_packages
        check.covered_packages
        check.bumps
        check.also_released
        check.missing_packages when check.status = failed
        check.api_findings when check.status = failed
        create_changeset_link(check.pull_request, check.missing_packages) when check.status = failed
}

surface ReleasePullRequestReview {
    facing maintainer: Maintainer
    context rpr: ReleasePullRequest where status = open

    exposes:
        rpr.releases

    provides:
        MaintainerMergesReleasePullRequest(maintainer, rpr)
        MaintainerClosesReleasePullRequest(maintainer, rpr)
}

surface PreReleaseRequest {
    facing maintainer: Maintainer
    context package: Package

    exposes:
        package.name
        package.version
        package.pending_changesets

    provides:
        MaintainerRequestsPreRelease(maintainer, package, target_branch, level)
}

-- After a merge the workflow receives every release the merge produced,
-- dependencies before dependents. Publishing to the registry is the
-- workflow's command; the tool runs that command once per tagged package
-- and owns the order and the stop. Packages in the workspace publish
-- share one command, run once from the root, after what its members
-- need from outside; each member's outcome is the registry's answer
-- afterwards, or the command's exit status without a registry. Packages
-- caught in a dependency cycle end as blocked.
-- Note: allium 3.3.0 witnesses only the first branch of an `if` chain in
-- a `for` clause, so `check` reports the other outcomes as unreachable.
-- `releases`, when the workflow hands over the list from `release`, keeps
-- the run to the packages it released: without it, every tagged package
-- runs its command again, and only a registry can tell that apart.
rule WorkflowPublishesInDependencyOrder {
    when: WorkflowRunsPublish(workflow, repository, releases?)
    let candidates = filter(Packages, p => p.repository = repository and p.release_mode != none and GitTags.any(t => t.package = p and t.version = p.version) and (releases = none or p in releases))
    requires: candidates.all(p => p.publish_command != null or p.in_workspace_publish)
    ensures:
        for p in candidates:
            -- A version the registry has is skipped before the command runs.
            -- Otherwise started only after every in-repo dependency among
            -- the candidates ended as published or exists. Independent
            -- packages run at the same time, up to the job limit.
            if p.on_registry(p.version) = true:
                PublishOutcome.created(package: p, status: `exists`)
            else if p.dependencies.any(d => d in candidates and PublishOutcomes.any(o => o.package = d and o.status in {failed, blocked})):
                PublishOutcome.created(package: p, status: blocked)
            else if publish_command_succeeded(p):
                PublishOutcome.created(package: p, status: published)
            else:
                PublishOutcome.created(package: p, status: failed)
}

entity PublishOutcome {
    package: Package
    status: published | `exists` | failed | blocked
}

invariant DependentsNeverPublishBeforeDependencies {
    PublishOutcomes.all(o => o.status != published or o.package.dependencies.all(d =>
        PublishOutcomes.all(x => x.package != d or x.status in {published, `exists`})))
}

surface WorkflowPublishHandoff {
    facing workflow: Workflow
    context outcome: PublishOutcome

    exposes:
        outcome.package.name
        outcome.status
}

surface ToolRun {
    facing workflow: Workflow
    context repository: Repository

    provides:
        ToolRunStarted(repository, named, publish_drafts)
        WorkflowRunsPublish(workflow, repository, releases)
}

-- Every release the run tagged, created, published or attached assets
-- to, every draft, and the named package's release: in dependency order,
-- so the workflow can publish in that order. previous_version is the
-- version under the next older changelog heading.
surface WorkflowReleaseHandoff {
    facing workflow: Workflow
    context release: Release

    exposes:
        release.package.name
        release.previous_version
        release.package.first_release
        release.version
        release.version.is_prerelease
        release.tag when release.status = tagged | drafted | published
        release.status

    provides:
        WorkflowPublishesRelease(workflow, release) when release.status = drafted
        WorkflowAttachesAssets(workflow, release, assets, package_named) when release.status = drafted | published

    @guidance
        -- Recommended order in the workflow: build, then tag and create
        -- the release with its assets (no draft), then publish to the
        -- registry. The irreversible step goes last. Drafts remain for
        -- assets that can only be built once the release exists.
}

-- Where every package stands and what finishes its release, so a
-- maintainer can take over from a failed workflow run.
surface ReleaseStatus {
    facing maintainer: Maintainer
    context package: Package

    exposes:
        package.version
        package.pending_changesets
        package.open_release_pull_request
        package.release_pull_requests

    @guidance
        -- The implementation derives the Release state from tags and the
        -- GitHub release (none, draft, published, assets) and names the
        -- command that finishes it. Every command is resumable: it reads
        -- the current state and skips what is done.
}

surface ReleaseAbandon {
    facing maintainer: Maintainer
    context release: Release where status != committed

    provides:
        MaintainerAbandonsRelease(maintainer, release)
}

surface FileFormatPlugin {
    facing workflow: Workflow

    contracts:
        demands VersionedFileHandler
}

